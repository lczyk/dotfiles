# the configured background. lists are in ansi order black red green yellow
# blue magenta cyan white. only wincolor consumes these so far.
set -gx PALETTE_LIGHT_BG e3e3e3
set -gx PALETTE_LIGHT_FG 3c3836
set -gx PALETTE_LIGHT_NORMAL a89984 cc241d 98971a d79921 458588 b16286 689d6a 504945
set -gx PALETTE_LIGHT_BRIGHT 928374 9d0006 79740e b57614 076678 8f3f71 427b58 282828
