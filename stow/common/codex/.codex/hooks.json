{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/hooks/safety-adapter.sh\" shell",
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/hooks/safety-adapter.sh\" patch",
            "type": "command"
          }
        ],
        "matcher": "^apply_patch$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "cat \"$HOME/.config/agent-guidance/workflow.md\"",
            "statusMessage": "Loading shared agent instructions...",
            "type": "command"
          },
          {
            "command": "node \"$HOME/.claude/hooks/caveman-activate.js\"",
            "statusMessage": "Loading caveman mode...",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "[ -f \"${AGENT_STATE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/agent-state}/lofi-off\" ] || cat \"$HOME/.config/agent-styles/lofi.md\"",
            "statusMessage": "Loading lofi style...",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "node \"$HOME/.claude/hooks/caveman-mode-tracker.js\"",
            "statusMessage": "Tracking caveman mode...",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "[ -f \"${AGENT_STATE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/agent-state}/lofi-off\" ] || cat \"$HOME/.config/agent-styles/lofi-reminder.md\"",
            "statusMessage": "Loading lofi style reminder...",
            "type": "command"
          }
        ]
      }
    ]
  }
}
