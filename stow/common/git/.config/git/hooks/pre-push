#!/usr/bin/env bash
# - agents: block pushing entirely, unless the session carries the push
#   capability -- then every ref gets the protected-branch rules below, plus
#   no tags.
# - humans: block force-push / deletion / non-ff to protected branches
#   (main, master, trunk, release/*).
#
# git invokes pre-push with: <remote-name> <remote-url>
# and feeds lines on stdin: <local-ref> <local-sha> <remote-ref> <remote-sha>

# agent harnesses take the strict path. AGENT_SESSION is set by our own harness
# configs; CLAUDECODE and OPENCODE_PID are native fallbacks. copilot exports
# nothing usable into spawned shells, so it lands on the human path -- known
# gap, and block-dangerous.sh still fences push there.
is_agent() {
    [ -n "$AGENT_SESSION" ] || [ "$CLAUDECODE" = "1" ] || [ -n "$OPENCODE_PID" ]
}

# capability opt-outs, comma-separated, read from this process's own
# environment -- the same contract as the shell policies: the user grants one
# at launch (env AGENT_UNFENCE=push <agent>) and it reaches this hook through
# the harness's spawned shell. kept inline so a missing helper can't turn the
# hook into a pass.
_unfenced() {
    case ",${AGENT_UNFENCE}," in
        (*",$1,"*) return 0 ;;
    esac
    return 1
}

AGENT=0
if is_agent; then
    if ! _unfenced push; then
        printf 'rejected: agents are not allowed to push. hand off to the user (the user can lift fast-forward pushes for a session with env AGENT_UNFENCE=push).\n' >&2
        exit 1
    fi
    AGENT=1
fi

PROTECTED_EXACT=(refs/heads/main refs/heads/master refs/heads/trunk)
PROTECTED_PREFIX=(refs/heads/release/)

is_protected() {
    local ref="$1"
    for p in "${PROTECTED_EXACT[@]}"; do
        [ "$ref" = "$p" ] && return 0
    done
    for p in "${PROTECTED_PREFIX[@]}"; do
        case "$ref" in
            "$p"*) return 0 ;;
        esac
    done
    return 1
}

is_force_invocation() {
    local parent_cmd
    if [ -r "/proc/$PPID/cmdline" ]; then
        parent_cmd=$(tr '\0' ' ' < "/proc/$PPID/cmdline")
    else
        parent_cmd=$(ps -o command= -p "$PPID" 2>/dev/null)
    fi
    case " $parent_cmd " in
        *" --force "*|*" -f "*|*" --force-with-lease"*) return 0 ;;
    esac
    return 1
}

z40="0000000000000000000000000000000000000000"

rc=0
# shellcheck disable=SC2034  # local_ref unused but part of the stdin format
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$remote_ref" ] && continue

    # tags are the user's. push.followTags drags reachable annotated ones
    # along, hence the hint.
    if [ "$AGENT" = 1 ]; then
        case "$remote_ref" in
            refs/tags/*)
                printf 'rejected: agents do not push tags (%s). retry with --no-follow-tags if one came along.\n' "$remote_ref" >&2
                rc=1
                continue
                ;;
        esac
        what="$remote_ref (agent session)"
    elif is_protected "$remote_ref"; then
        what="protected branch $remote_ref"
    else
        continue
    fi

    if [ "$local_sha" = "$z40" ]; then
        printf 'rejected: refusing to delete %s\n' "$what" >&2
        rc=1
        continue
    fi

    if [ "$remote_sha" != "$z40" ]; then
        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
            printf 'rejected: non-fast-forward push to %s\n' "$what" >&2
            printf 'rejected: force-pushing is blocked here. resolve via merge or revert instead.\n' >&2
            rc=1
            continue
        fi
    fi

    if is_force_invocation; then
        printf 'rejected: --force / --force-with-lease push to %s\n' "$what" >&2
        rc=1
    fi
done

exit "$rc"
