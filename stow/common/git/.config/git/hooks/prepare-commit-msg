#!/usr/bin/env bash
# - rewrite git's default revert message to conventional commits format.
#   Revert "<subject>" -> revert: "<subject>"
# - agents: reject --amend of a commit that is already on the upstream.
#
# git invokes prepare-commit-msg with: <msg-file> [<source> [<sha>]]
# --amend (and -c / -C HEAD) arrive as `commit HEAD`. runs even under
# --no-verify and --no-edit.

# the agent / capability helpers live with the agent policies.
_lib="$(dirname "$(readlink -f "$0")")/../../../../agent-hooks/.config/agent-hooks/lib.sh"
[ -r "$_lib" ] || _lib="$HOME/.config/agent-hooks/lib.sh"
# shellcheck source-path=SCRIPTDIR source=../../../../agent-hooks/.config/agent-hooks/lib.sh
. "$_lib" 2>/dev/null ||
    { echo "rejected: agent-hooks lib.sh not found (stow agent-hooks)" >&2; exit 1; }

MSGFILE="$1"
SOURCE="$2"
SHA="$3"

# HEAD reachable from @{u} = pushed, as of the last fetch. no upstream,
# detached HEAD and outside-a-repo all fail the lookup and count as unpushed.
head_is_pushed() {
    git merge-base --is-ancestor HEAD '@{u}' 2>/dev/null
}

if is_agent && [ "$SOURCE" = commit ] && [ "$SHA" = HEAD ] && head_is_pushed; then
    printf 'rejected: HEAD is already on its upstream -- amending it rewrites pushed history.\n' >&2
    printf 'rejected: make a new commit instead, or hand the amend to the user.\n' >&2
    exit 1
fi

subject=$(head -n1 "$MSGFILE")

if [[ "$subject" =~ ^Revert\ \"(.*)\"$ ]]; then
    inner="${BASH_REMATCH[1]}"
    new_subject="revert: \"${inner}\""
    rest=$(tail -n +2 "$MSGFILE")
    printf '%s\n' "$new_subject" > "$MSGFILE"
    if [ -n "$rest" ]; then
        printf '%s\n' "$rest" >> "$MSGFILE"
    fi
fi
